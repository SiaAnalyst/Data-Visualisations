            <column caption='Average Spending per Player' datatype='real' name='[Calculation_0765309473513476]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(Avg_Spending_USD)' />
            </column>
            <column caption='Revenue per Player' datatype='real' name='[Calculation_0765309473669125]' role='measure' type='quantitative'>

            <column caption='Active Players Million' datatype='real' name='[Active_Players_Million]' role='measure' type='quantitative' />
            <column caption='Avg Spending USD' datatype='real' name='[Avg_Spending_USD]' role='measure' type='quantitative' />
            <column caption='Total Gaming Revenue' datatype='real' name='[Calculation_0765309472972800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(Gaming_Revenue_BillionUSD)' />
            </column>
            <column caption='Revenue Growth' datatype='real' name='[Calculation_0765309473116161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Gaming_Revenue_BillionUSD]) -&#10;LOOKUP(SUM([Gaming_Revenue_BillionUSD]), -1))&#10;/&#10;LOOKUP(SUM([Gaming_Revenue_BillionUSD]), -1)'>
                <table-calc ordering-type='Rows' />
